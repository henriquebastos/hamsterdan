[Unit]
Description=Hamsterdan GitHub App host ({{ candidate_revision }})
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
ExecStartPre=-/usr/bin/docker rm hamsterdan
ExecStartPre=/bin/sh -ec 'OP_SERVICE_ACCOUNT_TOKEN=`cat {{ runtime_op_token_file }}`; export OP_SERVICE_ACCOUNT_TOKEN; {{ op_command }} inject --force --file-mode 0600 --in-file {{ runtime_root }}/env-prod.tpl --out-file {{ runtime_root }}/hamsterdan.env'
ExecStartPre=/bin/sh -ec 'OP_SERVICE_ACCOUNT_TOKEN=`cat {{ runtime_op_token_file }}`; export OP_SERVICE_ACCOUNT_TOKEN; {{ op_command }} document get github-app.pem --vault {{ runtime_vault }} --force --file-mode 0600 --out-file {{ runtime_secrets }}/github-app.pem; chown 10001:10001 {{ runtime_secrets }}/github-app.pem'
ExecStartPre=/bin/sh -ec 'OP_SERVICE_ACCOUNT_TOKEN=`cat {{ runtime_op_token_file }}`; export OP_SERVICE_ACCOUNT_TOKEN; {{ op_command }} read --no-newline --force --file-mode 0600 --out-file {{ runtime_secrets }}/webhook-secret op://{{ runtime_vault }}/github-app/webhook_secret; chown 10001:10001 {{ runtime_secrets }}/webhook-secret'
ExecStart=/usr/bin/docker run --rm --name hamsterdan --pull=never --read-only --cap-drop=ALL --security-opt=no-new-privileges --tmpfs=/tmp:rw,noexec,nosuid,nodev,size=268435456,mode=0700,uid=10001,gid=10001 --env-file /etc/hamsterdan/hamsterdan.env --mount=type=bind,source=/var/lib/hamsterdan,target=/var/lib/hamsterdan --mount=type=bind,source=/etc/hamsterdan/secrets,target=/run/secrets/hamsterdan,readonly --mount=type=bind,source=/etc/hamsterdan/config,target=/run/config/hamsterdan,readonly --publish=127.0.0.1:8000:8000 {{ candidate_image_id }} serve --host 0.0.0.0 --port 8000
ExecStop=/usr/bin/docker stop --time 30 hamsterdan

[Install]
WantedBy=multi-user.target
