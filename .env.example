# GitHub App identity and selected installation account
HAMSTERDAN_GITHUB_APP_ID=APP_ID
HAMSTERDAN_GITHUB_APP_SLUG=APP_SLUG
HAMSTERDAN_GITHUB_CLIENT_ID=CLIENT_ID
HAMSTERDAN_GITHUB_ACCOUNT_ID=ACCOUNT_ID
HAMSTERDAN_GITHUB_ACCOUNT_LOGIN=ACCOUNT_LOGIN
HAMSTERDAN_ALLOWED_REPOSITORIES=REPOSITORY_ID:OWNER/NAME

# Files must be regular, owner-only (0600), bounded files.
HAMSTERDAN_GITHUB_PRIVATE_KEY_FILE=/run/secrets/github-app-private-key
HAMSTERDAN_GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/github-webhook-secret
HAMSTERDAN_STATE_PATH=/var/lib/hamsterdan

# Agenticus is deterministic-only until the separately qualified live gate.
HAMSTERDAN_AGENT_MODE=agenticus
HAMSTERDAN_AGENT_ISOLATION_REQUIRED=true

HAMSTERDAN_HOST=127.0.0.1
HAMSTERDAN_PORT=8000
HAMSTERDAN_WORKFLOW_PATH=.github/workflows/ci.yml
HAMSTERDAN_REMINDER_SECONDS=259200
