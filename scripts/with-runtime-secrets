#!/usr/bin/env bash
set +x
set -euo pipefail

# Both local and container starts pass through this command. Scrub before op
# runs: an absent Environment variable must never inherit an earlier value.
: "${HAMSTERDAN_ENVIRONMENT_ID:?select a 1Password application Environment}"
[[ "$HAMSTERDAN_ENVIRONMENT_ID" =~ ^[a-z0-9]{26}$ ]] || exit 2
(( $# > 0 )) || exit 2
op_command="${HAMSTERDAN_OP_COMMAND:-op}"
op_config=()
if [[ -n "${OP_CONFIG_DIR:-}" ]]; then
    op_config=(--config "$OP_CONFIG_DIR")
fi
bootstrap="${OP_SERVICE_ACCOUNT_TOKEN:-}"
if [[ -n "${HAMSTERDAN_OP_TOKEN_FILE:-}" ]]; then
    [[ -f "$HAMSTERDAN_OP_TOKEN_FILE" && ! -L "$HAMSTERDAN_OP_TOKEN_FILE" ]] || exit 2
    bootstrap="$(< "$HAMSTERDAN_OP_TOKEN_FILE")"
    [[ -n "$bootstrap" ]] || exit 2
fi
for name in "${!OP_@}" "${!GH_@}" "${!GITHUB_@}" "${!AMP_@}" \
    "${!ANTHROPIC_@}" "${!OPENAI_@}" "${!OPENROUTER_@}" "${!PETRUS_@}" "${!EXE_DEV_@}"; do
    [[ -z "$name" ]] || unset "$name"
done
unset HAMSTERDAN_GITHUB_APP_ID HAMSTERDAN_GITHUB_APP_SLUG HAMSTERDAN_GITHUB_CLIENT_ID
unset HAMSTERDAN_GITHUB_WORKFLOW_TOKEN
unset HAMSTERDAN_GITHUB_PRIVATE_KEY HAMSTERDAN_GITHUB_WEBHOOK_SECRET HAMSTERDAN_PI_API_KEY
unset HAMSTERDAN_GITHUB_PRIVATE_KEY_FILE HAMSTERDAN_GITHUB_WEBHOOK_SECRET_FILE HAMSTERDAN_PI_API_KEY_FILE
if [[ -n "$bootstrap" ]]; then
    export OP_SERVICE_ACCOUNT_TOKEN="$bootstrap"
fi
unset bootstrap
exec "$op_command" run --environment "$HAMSTERDAN_ENVIRONMENT_ID" "${op_config[@]}" -- \
    env -u OP_SERVICE_ACCOUNT_TOKEN -u HAMSTERDAN_OP_TOKEN_FILE -u HAMSTERDAN_OP_COMMAND "$@"
