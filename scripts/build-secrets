#!/usr/bin/env bash
set +x
set -euo pipefail
cd "$(dirname "$0")/.."
bootstrap="${OP_SA_HAMSTERDAN_BUILD:-}"
if [[ -n "${HAMSTERDAN_BUILD_TOKEN_FILE:-}" ]]; then
    bootstrap="$(< "$HAMSTERDAN_BUILD_TOKEN_FILE")"
    [[ -n "$bootstrap" ]] || exit 2
fi
for name in "${!OP_@}" "${!PETRUS_@}" "${!EXE_DEV_@}"; do
    [[ -z "$name" ]] || unset "$name"
done
if [[ -n "$bootstrap" ]]; then
    export OP_SERVICE_ACCOUNT_TOKEN="$bootstrap"
fi
unset bootstrap
exec op run --env-file=env-build.tpl -- env -u OP_SERVICE_ACCOUNT_TOKEN "$@"
