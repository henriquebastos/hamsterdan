#!/usr/bin/env bash
set +x
set -euo pipefail
cd "$(dirname "$0")/.."
bootstrap="${OP_SA_HAMSTERDAN_OPS:-}"
if [[ -n "${HAMSTERDAN_OPS_TOKEN_FILE:-}" ]]; then
    bootstrap="$(< "$HAMSTERDAN_OPS_TOKEN_FILE")"
    [[ -n "$bootstrap" ]] || exit 2
fi
for name in "${!OP_@}" "${!PETRUS_@}" "${!EXE_DEV_@}" "${!OPENAI_@}" "${!OPENROUTER_@}" "${!ANTHROPIC_@}"; do
    [[ -z "$name" ]] || unset "$name"
done
if [[ -n "$bootstrap" ]]; then
    export OP_SERVICE_ACCOUNT_TOKEN="$bootstrap"
fi
unset bootstrap
files=(--env-file=env-ops.tpl)
if [[ "${1:-}" == --provision ]]; then
    files+=(--env-file=env-provision.tpl)
    shift
fi
(( $# > 0 )) || exit 2
exec op run "${files[@]}" -- env -u OP_SERVICE_ACCOUNT_TOKEN "$@"
