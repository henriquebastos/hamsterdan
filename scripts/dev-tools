#!/usr/bin/env bash
set +x
set -euo pipefail
cd "$(dirname "$0")/.."
bootstrap="${OP_SA_HAMSTERDAN_DEV_TOOLS:-}"
if [[ -n "${HAMSTERDAN_TOOLS_TOKEN_FILE:-}" ]]; then
    bootstrap="$(< "$HAMSTERDAN_TOOLS_TOKEN_FILE")"
    [[ -n "$bootstrap" ]] || exit 2
fi
for name in "${!OP_@}"; do
    [[ -z "$name" ]] || unset "$name"
done
if [[ -n "$bootstrap" ]]; then
    export OP_SERVICE_ACCOUNT_TOKEN="$bootstrap"
fi
unset bootstrap
exec op run --env-file=env-tools.tpl -- env -u OP_SERVICE_ACCOUNT_TOKEN "$@"
