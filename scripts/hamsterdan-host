#!/usr/bin/env bash
set +x
set -euo pipefail
cd "$(dirname "$0")/.."
set -a
source deployment/config/runtime.env
set +a
export HAMSTERDAN_GITHUB_INSTALLATIONS_FILE="$PWD/deployment/config/installations.toml"
export HAMSTERDAN_STATE_PATH="${HAMSTERDAN_STATE_PATH:-$PWD/.amp/runtime/state}"
pi_prefix="$PWD/.amp/runtime/pi-install/node_modules"
export HAMSTERDAN_PI_PACKAGE_ROOT="${HAMSTERDAN_PI_PACKAGE_ROOT:-$pi_prefix/@earendil-works/pi-coding-agent}"
export HAMSTERDAN_PI_CLI_PATH="${HAMSTERDAN_PI_CLI_PATH:-$HAMSTERDAN_PI_PACKAGE_ROOT/dist/cli.js}"
export HAMSTERDAN_PI_NODE_PATH="${HAMSTERDAN_PI_NODE_PATH:-$pi_prefix/node/bin/node}"
if (( $# == 0 )); then
    set -- serve --host 0.0.0.0 --port "${PORT:-8000}"
fi
exec scripts/with-runtime-secrets uv run --frozen --no-env-file python -m hamsterdan.host "$@"
