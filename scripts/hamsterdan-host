#!/usr/bin/env python3
"""Launch the host only from one stable, private, generated environment."""

from __future__ import annotations

import os
import re
import stat
import sys


AMP_DIRECTORY = ".amp"
RUNTIME_DIRECTORY = "runtime"
ENVIRONMENT = "hamsterdan.env"
MAX_BYTES = 64 * 1024
REQUIRED = {
    "HAMSTERDAN_ALLOWED_REPOSITORIES",
    "HAMSTERDAN_GITHUB_ACCOUNT_ID",
    "HAMSTERDAN_GITHUB_ACCOUNT_LOGIN",
    "HAMSTERDAN_GITHUB_APP_ID",
    "HAMSTERDAN_GITHUB_APP_SLUG",
    "HAMSTERDAN_GITHUB_CLIENT_ID",
    "HAMSTERDAN_GITHUB_PRIVATE_KEY_FILE",
    "HAMSTERDAN_GITHUB_WEBHOOK_SECRET_FILE",
    "HAMSTERDAN_PI_API_KEY_FILE",
    "HAMSTERDAN_PI_CLI_PATH",
    "HAMSTERDAN_PI_MODEL",
    "HAMSTERDAN_PI_NODE_PATH",
    "HAMSTERDAN_PI_PACKAGE_ROOT",
    "HAMSTERDAN_PI_PROVIDER",
    "HAMSTERDAN_REMINDER_SECONDS",
    "HAMSTERDAN_STATE_PATH",
    "HAMSTERDAN_WORKFLOW_PATH",
}
LINE = re.compile(r"([A-Z][A-Z0-9_]*)=([^\x00-\x20\x7f]+)\Z")


def _fail() -> None:
    raise SystemExit("Hamsterdan runtime environment is unavailable")


def _open_runtime() -> int:
    try:
        flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
        amp = os.open(AMP_DIRECTORY, flags)
        try:
            amp_metadata = os.fstat(amp)
            if (
                not stat.S_ISDIR(amp_metadata.st_mode)
                or stat.S_IMODE(amp_metadata.st_mode) != 0o700
                or amp_metadata.st_uid != os.geteuid()
            ):
                _fail()
            runtime = os.open(RUNTIME_DIRECTORY, flags, dir_fd=amp)
        finally:
            os.close(amp)
        runtime_metadata = os.fstat(runtime)
        if (
            not stat.S_ISDIR(runtime_metadata.st_mode)
            or stat.S_IMODE(runtime_metadata.st_mode) != 0o700
            or runtime_metadata.st_uid != os.geteuid()
        ):
            os.close(runtime)
            _fail()
        return runtime
    except OSError:
        _fail()


def _read(runtime: int, name: str, maximum: int = MAX_BYTES) -> bytes:
    try:
        before = os.stat(name, dir_fd=runtime, follow_symlinks=False)
        if (
            stat.S_ISLNK(before.st_mode)
            or not stat.S_ISREG(before.st_mode)
            or stat.S_IMODE(before.st_mode) != 0o600
            or before.st_uid != os.geteuid()
            or not 0 < before.st_size <= maximum
        ):
            _fail()
        descriptor = os.open(name, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0), dir_fd=runtime)
        try:
            opened = os.fstat(descriptor)
            if (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino):
                _fail()
            value = os.read(descriptor, maximum + 1)
            if os.read(descriptor, 1):
                _fail()
            after = os.fstat(descriptor)
        finally:
            os.close(descriptor)
    except OSError:
        _fail()
    if len(value) != before.st_size or (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns) != (
        opened.st_dev,
        opened.st_ino,
        opened.st_size,
        opened.st_mtime_ns,
    ):
        _fail()
    return value


def _parse(value: bytes) -> dict[str, str]:
    try:
        lines = value.decode("ascii").splitlines()
    except UnicodeDecodeError:
        _fail()
    parsed: dict[str, str] = {}
    for line in lines:
        matched = LINE.fullmatch(line)
        if matched is None or matched[1] in parsed:
            _fail()
        parsed[matched[1]] = matched[2]
    if set(parsed) != REQUIRED:
        _fail()
    qualified = {
        "anthropic": "claude-sonnet-4-5",
        "openai": "gpt-5.6-sol",
        "openrouter": "anthropic/claude-sonnet-4.5",
    }
    if qualified.get(parsed["HAMSTERDAN_PI_PROVIDER"]) != parsed["HAMSTERDAN_PI_MODEL"]:
        _fail()
    if parsed["HAMSTERDAN_PI_API_KEY_FILE"] != os.path.abspath(
        os.path.join(AMP_DIRECTORY, RUNTIME_DIRECTORY, "agent-api-key")
    ):
        _fail()
    return parsed


def main() -> None:
    arguments = tuple(sys.argv[1:])
    if arguments[:1] == ("topology",):
        _fail()
    runtime = _open_runtime()
    try:
        port = os.getenv("PORT", "8000")
        if not port.isascii() or not port.isdecimal() or not 1 <= int(port) <= 65535:
            _fail()
        stripped_prefixes = (
            "AMP_",
            "ANTHROPIC_",
            "GH_",
            "GITHUB_",
            "HAMSTERDAN_",
            "OPENAI_",
            "OPENROUTER_",
        )
        environment = {name: value for name, value in os.environ.items() if not name.startswith(stripped_prefixes)}
        qualification_fault = os.getenv("HAMSTERDAN_QUALIFICATION_FAULT")
        if qualification_fault:
            environment["HAMSTERDAN_QUALIFICATION_FAULT"] = qualification_fault
        environment.update(_parse(_read(runtime, ENVIRONMENT)))
    finally:
        os.close(runtime)
    host_arguments = arguments or ("serve", "--host", "0.0.0.0", "--port", port)
    command = (
        "uv",
        "run",
        "--frozen",
        "python",
        "-m",
        "hamsterdan.host",
        *host_arguments,
    )
    os.execvpe(command[0], command, environment)


if __name__ == "__main__":
    try:
        main()
    except OSError:
        _fail()
    except ValueError:
        _fail()
