#!/usr/bin/env bash
set +x
set -euo pipefail
export LC_ALL=C

RUNTIME=.amp/runtime
for name in "${!OP_@}" "${!GH_@}" "${!GITHUB_@}" "${!AMP_@}" \
    "${!ANTHROPIC_@}" "${!OPENAI_@}" "${!OPENROUTER_@}" "${!PETRUS_@}" "${!EXE_DEV_@}"; do
    [[ -z "$name" ]] || unset "$name"
done
unset HAMSTERDAN_GITHUB_APP_ID HAMSTERDAN_GITHUB_APP_SLUG HAMSTERDAN_GITHUB_CLIENT_ID
unset HAMSTERDAN_GITHUB_WORKFLOW_TOKEN
unset HAMSTERDAN_GITHUB_PRIVATE_KEY HAMSTERDAN_GITHUB_WEBHOOK_SECRET HAMSTERDAN_PI_API_KEY

fail() {
    echo "==> Hamsterdan setup refused unsafe runtime custody" >&2
    exit 1
}

assert_private_directory() {
    local path="$1"
    [[ ! -L "$path" ]] || fail
    if [[ ! -e "$path" ]]; then
        install -d -m 0700 "$path"
    fi
    [[ -d "$path" && ! -L "$path" ]] || fail
    [[ "$(stat -c '%u' "$path")" = "$(id -u)" ]] || fail
    chmod 0700 "$path"
    [[ "$(stat -c '%a' "$path")" = 700 ]] || fail
}

retire_managed_file() {
    local path="$1"
    [[ ! -L "$path" ]] || fail
    if [[ -e "$path" ]]; then
        [[ -f "$path" ]] || fail
        rm -- "$path"
    fi
}

retire_identity() {
    local root="$1"
    [[ ! -L "$root" ]] || fail
    if [[ ! -e "$root" ]]; then
        return
    fi
    [[ -d "$root" ]] || fail
    [[ ! -L "$root/gh" ]] || fail
    if [[ -d "$root/gh" ]]; then
        retire_managed_file "$root/gh/hosts.yml"
        retire_managed_file "$root/gh/config.yml"
        rmdir -- "$root/gh" 2>/dev/null || fail
    fi
    [[ ! -L "$root/amp" ]] || fail
    if [[ -d "$root/amp" ]]; then
        rmdir -- "$root/amp" 2>/dev/null || fail
    fi
    rmdir -- "$root" 2>/dev/null || fail
}

assert_private_directory .amp
assert_private_directory "$RUNTIME"
retire_managed_file "$RUNTIME/readiness-topology"
retire_identity "$RUNTIME/gh-demo-author"
retire_identity "$RUNTIME/gh-demo-reviewer"
echo "==> Demo identities are acquired only by scripts/demo-github"

missing_petrus_feedback_tools=()
command -v docker >/dev/null 2>&1 || missing_petrus_feedback_tools+=(docker.io)
docker buildx version >/dev/null 2>&1 || missing_petrus_feedback_tools+=(docker-buildx-plugin)
command -v dot >/dev/null 2>&1 || missing_petrus_feedback_tools+=(graphviz)
if (( ${#missing_petrus_feedback_tools[@]} > 0 )); then
    echo "==> Installing container and Petrus feedback tools"
    sudo apt-get update
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing_petrus_feedback_tools[@]}"
else
    echo "==> Container and Petrus feedback tools already available"
fi
command -v docker >/dev/null 2>&1
docker buildx version >/dev/null 2>&1
command -v dot >/dev/null 2>&1

echo "==> Starting Docker for Petrus PostgreSQL feedback"
sudo usermod -aG docker "$(id -un)"
sudo mkdir -p /etc/systemd/system/docker.socket.d
sudo tee /etc/systemd/system/docker.socket.d/orb.conf >/dev/null <<'EOF'
[Socket]
SocketMode=0666
EOF
sudo systemctl daemon-reload
sudo systemctl enable --now docker.socket docker.service
[[ ! -S /var/run/docker.sock ]] || sudo chmod 666 /var/run/docker.sock

echo "==> Installing uv"
if ! command -v uv >/dev/null 2>&1; then
    curl -LsSf https://astral.sh/uv/install.sh | sh
fi
export PATH="$HOME/.local/bin:$PATH"

echo "==> Installing Bun"
if ! command -v bun >/dev/null 2>&1; then
    curl -fsSL https://bun.sh/install | bash -s "bun-v1.3.10"
fi
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

echo "==> Syncing the locked Hamsterdan environment"
uv sync --frozen

missing_media_tools=()
if ! command -v ffmpeg >/dev/null 2>&1 || ! command -v ffprobe >/dev/null 2>&1; then
    missing_media_tools+=(ffmpeg)
fi
command -v montage >/dev/null 2>&1 || missing_media_tools+=(imagemagick)
if (( ${#missing_media_tools[@]} > 0 )); then
    echo "==> Installing demo-video media tools"
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing_media_tools[@]}"
else
    echo "==> Demo-video media tools already available"
fi

echo "==> Syncing the locked demo-video environment"
(
    cd tools/demo-video
    bun install --frozen-lockfile
    bunx playwright install --with-deps chromium
)

echo "==> Installing the qualified Pi runtime"
PI_PREFIX="$PWD/$RUNTIME/pi-install"
assert_private_directory "$PI_PREFIX"
install -m 0600 deployment/pi/package.json "$PI_PREFIX/package.json"
install -m 0600 deployment/pi/package-lock.json "$PI_PREFIX/package-lock.json"
npm ci --prefix "$PI_PREFIX" --silent --no-audit --no-fund
pi_package="$PI_PREFIX/node_modules/@earendil-works/pi-coding-agent"
pi_cli="$pi_package/dist/cli.js"
pi_node="$PI_PREFIX/node_modules/node/bin/node"
[[ -f "$pi_cli" && -f "$pi_package/dist/index.js" && -x "$pi_node" ]] || fail

state_path="$PWD/$RUNTIME/state"
assert_private_directory "$state_path"
echo "==> Hamsterdan tools installed; scripts/hamsterdan-host retrieves application credentials on every start"
