#!/usr/bin/env bash
set +x
set -euo pipefail
export LC_ALL=C

MAX_PRIVATE_BYTES=65536
RUNTIME=.amp/runtime
SYSTEM_GH=/usr/bin/gh
if [[ ! -x "$SYSTEM_GH" ]]; then
    SYSTEM_GH="$HOME/.local/bin/gh"
fi

demo_author_hosts="${GITHUB_DEMO_AUTHOR_HOSTS:-}"
demo_reviewer_hosts="${GITHUB_DEMO_REVIEWER_HOSTS:-}"
github_app_key="${GITHUB_APP_PRIVATE_KEY_PEM:-}"
github_webhook_secret="${GITHUB_APP_WEBHOOK_SECRET:-}"
anthropic_key="${ANTHROPIC_AGENT_API_KEY:-${ANTHROPIC_API_KEY:-}}"
openai_key="${OPENAI_AGENT_API_KEY:-${OPENAI_API_KEY:-}}"
openrouter_key="${OPENROUTER_AGENT_API_KEY:-${OPENROUTER_API_KEY:-}}"
petrus_github_token="${PETRUS_GITHUB_TOKEN:-}"
unset GITHUB_DEMO_AUTHOR_HOSTS GITHUB_DEMO_REVIEWER_HOSTS
unset GITHUB_APP_PRIVATE_KEY_PEM GITHUB_APP_WEBHOOK_SECRET
unset ANTHROPIC_AGENT_API_KEY ANTHROPIC_API_KEY
unset OPENAI_AGENT_API_KEY OPENAI_API_KEY OPENROUTER_AGENT_API_KEY OPENROUTER_API_KEY
unset PETRUS_GITHUB_TOKEN

pi_provider=""
pi_model=""
pi_key=""
if [[ -n "$anthropic_key" ]]; then
    pi_provider=anthropic
    pi_model=claude-sonnet-4-5
    pi_key="$anthropic_key"
elif [[ -n "$openai_key" ]]; then
    pi_provider=openai
    pi_model=gpt-5.6-sol
    pi_key="$openai_key"
elif [[ -n "$openrouter_key" ]]; then
    pi_provider=openrouter
    pi_model=anthropic/claude-sonnet-4.5
    pi_key="$openrouter_key"
fi
unset anthropic_key openai_key openrouter_key

fail() {
    echo "==> Hamsterdan setup refused unsafe runtime custody" >&2
    exit 1
}

assert_private_directory() {
    local path="$1"
    [[ ! -L "$path" ]] || fail
    if [[ ! -e "$path" ]]; then
        install -d -m 0700 "$path"
    fi
    [[ -d "$path" && ! -L "$path" ]] || fail
    [[ "$(stat -c '%u' "$path")" = "$(id -u)" ]] || fail
    chmod 0700 "$path"
    [[ "$(stat -c '%a' "$path")" = 700 ]] || fail
}

retire_managed_file() {
    local path="$1"
    [[ ! -L "$path" ]] || fail
    if [[ -e "$path" ]]; then
        [[ -f "$path" ]] || fail
        rm -- "$path"
    fi
}

verify_private_file() {
    local path="$1"
    [[ -f "$path" && ! -L "$path" ]] || fail
    [[ "$(stat -c '%u' "$path")" = "$(id -u)" ]] || fail
    [[ "$(stat -c '%a' "$path")" = 600 ]] || fail
    local size
    size="$(stat -c '%s' "$path")"
    (( size > 0 && size <= MAX_PRIVATE_BYTES )) || fail
}

install_private_file() {
    local path="$1"
    local value="$2"
    local parent temporary
    parent="$(dirname "$path")"
    assert_private_directory "$parent"
    [[ ! -L "$path" ]] || fail
    [[ ! -e "$path" || -f "$path" ]] || fail
    if [[ -z "$value" ]]; then
        retire_managed_file "$path"
        return
    fi
    (( ${#value} <= MAX_PRIVATE_BYTES )) || fail
    temporary="$(mktemp "$parent/.hamsterdan-private.XXXXXX")"
    chmod 0600 "$temporary"
    printf '%s' "$value" > "$temporary"
    mv -fT -- "$temporary" "$path"
    verify_private_file "$path"
}

sync_private_petrus_dependency() {
    local auth_root token_file askpass_file config_file status
    [[ -n "$petrus_github_token" ]] || {
        echo "==> PETRUS_GITHUB_TOKEN is required to install the private Petrus dependency" >&2
        return 1
    }
    (( ${#petrus_github_token} <= MAX_PRIVATE_BYTES )) || fail
    auth_root="$(mktemp -d "$RUNTIME/.petrus-git-auth.XXXXXX")"
    chmod 0700 "$auth_root"
    token_file="$auth_root/token"
    askpass_file="$auth_root/askpass"
    config_file="$auth_root/config"
    cleanup_petrus_auth() {
        rm -rf -- "$auth_root"
    }
    trap cleanup_petrus_auth EXIT
    install -m 0600 /dev/null "$token_file"
    printf '%s' "$petrus_github_token" > "$token_file"
    unset petrus_github_token
    cat > "$askpass_file" <<EOF
#!/usr/bin/env bash
case "\${1:-}" in
    *Username*) printf '%s\\n' x-access-token ;;
    *Password*) cat '$PWD/$token_file'; printf '\\n' ;;
    *) exit 1 ;;
esac
EOF
    chmod 0700 "$askpass_file"
    cat > "$config_file" <<EOF
[core]
    askPass = $PWD/$askpass_file
[credential "https://github.com/henriquebastos/petrus"]
    username = x-access-token
EOF
    chmod 0600 "$config_file"
    status=0
    GIT_CONFIG_GLOBAL="$PWD/$config_file" GIT_CONFIG_SYSTEM=/dev/null \
        GIT_TERMINAL_PROMPT=0 uv sync --frozen || status=$?
    cleanup_petrus_auth
    trap - EXIT
    return "$status"
}

retire_identity() {
    local root="$1"
    [[ ! -L "$root" ]] || fail
    if [[ ! -e "$root" ]]; then
        return
    fi
    [[ -d "$root" ]] || fail
    [[ ! -L "$root/gh" ]] || fail
    if [[ -d "$root/gh" ]]; then
        retire_managed_file "$root/gh/hosts.yml"
        rmdir -- "$root/gh" 2>/dev/null || fail
    fi
    rmdir -- "$root" 2>/dev/null || fail
}

install_identity() {
    local root="$1"
    local value="$2"
    if [[ -z "$value" ]]; then
        retire_identity "$root"
        return
    fi
    assert_private_directory "$root"
    assert_private_directory "$root/gh"
    install_private_file "$root/gh/hosts.yml" "$value"
}

verify_identity() {
    local root="$1"
    local expected="$2"
    local observed
    [[ "$expected" =~ ^[A-Za-z0-9-]{1,39}$ ]] || return 1
    verify_private_file "$root/gh/hosts.yml"
    [[ -x "$SYSTEM_GH" && ! -L "$SYSTEM_GH" ]] || fail
    observed="$(/usr/bin/env -i HOME="$HOME" PATH="/usr/bin:/bin" XDG_CONFIG_HOME="$PWD/$root" "$SYSTEM_GH" api user --jq .login)" || return 1
    [[ "$observed" = "$expected" ]]
}

assert_private_directory .amp
assert_private_directory "$RUNTIME"
retire_managed_file "$RUNTIME/hamsterdan.env"
retire_managed_file "$RUNTIME/readiness-topology"

if [[ -n "$demo_author_hosts" && -n "$demo_reviewer_hosts" \
    && -n "${GITHUB_DEMO_AUTHOR_LOGIN:-}" && -n "${GITHUB_DEMO_REVIEWER_LOGIN:-}" \
    && "$GITHUB_DEMO_AUTHOR_LOGIN" != "$GITHUB_DEMO_REVIEWER_LOGIN" ]]; then
    install_identity "$RUNTIME/gh-demo-author" "$demo_author_hosts"
    install_identity "$RUNTIME/gh-demo-reviewer" "$demo_reviewer_hosts"
    if verify_identity "$RUNTIME/gh-demo-author" "$GITHUB_DEMO_AUTHOR_LOGIN" \
        && verify_identity "$RUNTIME/gh-demo-reviewer" "$GITHUB_DEMO_REVIEWER_LOGIN"; then
        echo "==> Optional demo identities verified"
    else
        retire_identity "$RUNTIME/gh-demo-author"
        retire_identity "$RUNTIME/gh-demo-reviewer"
        echo "==> Optional demo identities are not valid and were not retained"
    fi
else
    retire_identity "$RUNTIME/gh-demo-author"
    retire_identity "$RUNTIME/gh-demo-reviewer"
    echo "==> Optional demo identities are not configured"
fi
install_private_file "$RUNTIME/github-app.pem" "$github_app_key"
install_private_file "$RUNTIME/webhook-secret" "$github_webhook_secret"
retire_managed_file "$RUNTIME/anthropic-api-key"
install_private_file "$RUNTIME/agent-api-key" "$pi_key"
unset demo_author_hosts demo_reviewer_hosts github_app_key github_webhook_secret pi_key

echo "==> Installing uv"
if ! command -v uv >/dev/null 2>&1; then
    curl -LsSf https://astral.sh/uv/install.sh | sh
fi
export PATH="$HOME/.local/bin:$PATH"

echo "==> Installing Bun"
if ! command -v bun >/dev/null 2>&1; then
    curl -fsSL https://bun.sh/install | bash -s "bun-v1.3.10"
fi
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

echo "==> Syncing the locked Hamsterdan environment"
sync_private_petrus_dependency

missing_media_tools=()
if ! command -v ffmpeg >/dev/null 2>&1 || ! command -v ffprobe >/dev/null 2>&1; then
    missing_media_tools+=(ffmpeg)
fi
command -v montage >/dev/null 2>&1 || missing_media_tools+=(imagemagick)
if (( ${#missing_media_tools[@]} > 0 )); then
    echo "==> Installing demo-video media tools"
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing_media_tools[@]}"
else
    echo "==> Demo-video media tools already available"
fi

echo "==> Syncing the locked demo-video environment"
(
    cd tools/demo-video
    bun install --frozen-lockfile
    bunx playwright install --with-deps chromium
)

echo "==> Installing the qualified Pi runtime"
PI_PREFIX="$PWD/$RUNTIME/pi-install"
assert_private_directory "$PI_PREFIX"
install -m 0600 deployment/pi/package.json "$PI_PREFIX/package.json"
install -m 0600 deployment/pi/package-lock.json "$PI_PREFIX/package-lock.json"
npm ci --prefix "$PI_PREFIX" --silent --no-audit --no-fund
pi_package="$PI_PREFIX/node_modules/@earendil-works/pi-coding-agent"
pi_cli="$pi_package/dist/cli.js"
pi_node="$PI_PREFIX/node_modules/node/bin/node"
[[ -f "$pi_cli" && -f "$pi_package/dist/index.js" && -x "$pi_node" ]] || fail

runtime_ready=true
for name in \
    GITHUB_APP_ID GITHUB_APP_SLUG GITHUB_APP_CLIENT_ID \
    GITHUB_INSTALLATION_ACCOUNT_ID GITHUB_INSTALLATION_ACCOUNT_LOGIN \
    GITHUB_INSTALLATION_REPOSITORIES READINESS_WORKFLOW_PATH READINESS_REMINDER_SECONDS; do
    if [[ -z "${!name:-}" ]]; then
        runtime_ready=false
    fi
done
for path in \
    "$RUNTIME/github-app.pem" "$RUNTIME/webhook-secret" "$RUNTIME/agent-api-key"; do
    if [[ ! -f "$path" || -L "$path" ]]; then
        runtime_ready=false
    fi
done

if [[ "$runtime_ready" != true ]]; then
    echo "==> Optional Hamsterdan live runtime is not fully configured"
    exit 0
fi

retire_identity "$RUNTIME/gh-henriquebastos"
retire_identity "$RUNTIME/gh-crisbastos"

[[ "$GITHUB_APP_ID" =~ ^[1-9][0-9]*$ ]] || fail
[[ "$GITHUB_APP_SLUG" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || fail
[[ "$GITHUB_APP_CLIENT_ID" =~ ^[A-Za-z0-9_-]{1,128}$ ]] || fail
[[ "$GITHUB_INSTALLATION_ACCOUNT_ID" =~ ^[1-9][0-9]*$ ]] || fail
[[ "$GITHUB_INSTALLATION_ACCOUNT_LOGIN" =~ ^[A-Za-z0-9-]{1,39}$ ]] || fail
[[ "$GITHUB_INSTALLATION_REPOSITORIES" =~ ^[1-9][0-9]*:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(,[1-9][0-9]*:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)*$ ]] || fail
[[ "$READINESS_WORKFLOW_PATH" =~ ^[A-Za-z0-9_./-]+$ ]] || fail
[[ "$READINESS_REMINDER_SECONDS" =~ ^[1-9][0-9]*$ ]] || fail

state_path="$PWD/$RUNTIME/state"
assert_private_directory "$state_path"
for path in "$RUNTIME/github-app.pem" "$RUNTIME/webhook-secret" "$RUNTIME/agent-api-key"; do
    verify_private_file "$path"
done

temporary="$(mktemp "$RUNTIME/.hamsterdan-env.XXXXXX")"
chmod 0600 "$temporary"
{
    printf 'HAMSTERDAN_GITHUB_APP_ID=%s\n' "$GITHUB_APP_ID"
    printf 'HAMSTERDAN_GITHUB_APP_SLUG=%s\n' "$GITHUB_APP_SLUG"
    printf 'HAMSTERDAN_GITHUB_CLIENT_ID=%s\n' "$GITHUB_APP_CLIENT_ID"
    printf 'HAMSTERDAN_GITHUB_ACCOUNT_ID=%s\n' "$GITHUB_INSTALLATION_ACCOUNT_ID"
    printf 'HAMSTERDAN_GITHUB_ACCOUNT_LOGIN=%s\n' "$GITHUB_INSTALLATION_ACCOUNT_LOGIN"
    printf 'HAMSTERDAN_ALLOWED_REPOSITORIES=%s\n' "$GITHUB_INSTALLATION_REPOSITORIES"
    printf 'HAMSTERDAN_STATE_PATH=%s\n' "$state_path"
    printf 'HAMSTERDAN_GITHUB_PRIVATE_KEY_FILE=%s\n' "$PWD/$RUNTIME/github-app.pem"
    printf 'HAMSTERDAN_GITHUB_WEBHOOK_SECRET_FILE=%s\n' "$PWD/$RUNTIME/webhook-secret"
    printf 'HAMSTERDAN_PI_PROVIDER=%s\n' "$pi_provider"
    printf 'HAMSTERDAN_PI_MODEL=%s\n' "$pi_model"
    printf 'HAMSTERDAN_PI_API_KEY_FILE=%s\n' "$PWD/$RUNTIME/agent-api-key"
    printf 'HAMSTERDAN_PI_CLI_PATH=%s\n' "$pi_cli"
    printf 'HAMSTERDAN_PI_NODE_PATH=%s\n' "$pi_node"
    printf 'HAMSTERDAN_PI_PACKAGE_ROOT=%s\n' "$pi_package"
    printf 'HAMSTERDAN_WORKFLOW_PATH=%s\n' "$READINESS_WORKFLOW_PATH"
    printf 'HAMSTERDAN_REMINDER_SECONDS=%s\n' "$READINESS_REMINDER_SECONDS"
} > "$temporary"
mv -fT -- "$temporary" "$RUNTIME/hamsterdan.env"
verify_private_file "$RUNTIME/hamsterdan.env"
unset pi_provider pi_model

echo "==> Hamsterdan orb setup complete"
