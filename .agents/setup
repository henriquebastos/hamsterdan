#!/usr/bin/env bash
set -euo pipefail

echo "==> Installing uv"
if ! command -v uv >/dev/null 2>&1; then
    curl -LsSf https://astral.sh/uv/install.sh | sh
fi
export PATH="$HOME/.local/bin:$PATH"

echo "==> Installing Bun"
if ! command -v bun >/dev/null 2>&1; then
    curl -fsSL https://bun.sh/install | bash -s "bun-v1.3.10"
fi
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

echo "==> Syncing the locked Hamsterdan environment"
uv sync --frozen

missing_media_tools=()
if ! command -v ffmpeg >/dev/null 2>&1 || ! command -v ffprobe >/dev/null 2>&1; then
    missing_media_tools+=(ffmpeg)
fi
command -v montage >/dev/null 2>&1 || missing_media_tools+=(imagemagick)
if (( ${#missing_media_tools[@]} > 0 )); then
    echo "==> Installing demo-video media tools"
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing_media_tools[@]}"
else
    echo "==> Demo-video media tools already available"
fi

echo "==> Syncing the locked demo-video environment"
(
    cd tools/demo-video
    bun install --frozen-lockfile
    bunx remotion browser ensure
)

install_gh_identity() {
    local variable="$1"
    local config_root="$2"
    local value="${!variable:-}"
    if [[ -z "$value" ]]; then
        echo "==> Optional GitHub identity $variable is not configured"
        return
    fi
    install -d -m 0700 "$config_root" "$config_root/gh"
    umask 077
    printf '%s' "$value" > "$config_root/gh/hosts.yml"
    chmod 0600 "$config_root/gh/hosts.yml"
}

echo "==> Installing project-scoped human GitHub operator identities"
install_gh_identity HAMSTERDAN_GITHUB_HENRIQUEBASTOS_HOSTS .amp/runtime/gh-henriquebastos
install_gh_identity HAMSTERDAN_GITHUB_CRISBASTOS_HOSTS .amp/runtime/gh-crisbastos
unset HAMSTERDAN_GITHUB_HENRIQUEBASTOS_HOSTS HAMSTERDAN_GITHUB_CRISBASTOS_HOSTS

echo "==> Hamsterdan orb setup complete"
